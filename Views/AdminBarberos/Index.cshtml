@model List<Barbero>
@{
    ViewData["Titulo"] = "Barberos";
}

<h1>Barberos</h1>

<p><a href="/admin/barberos/crear">Nuevo barbero</a></p>

@if (Model.Count == 0)
{
    <partial name="_AvisoVacio" model='"Todavía no hay barberos. Crea el primero."' />
}
else
{
    <table style="width: 100%; border-collapse: collapse;">
        <thead>
            <tr style="text-align: left; border-bottom: 2px solid #c9a24b;">
                <th>Nombre</th>
                <th>Estado</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var barbero in Model)
            {
                <tr style="border-bottom: 1px solid #ddd;">
                    <td>@barbero.Nombre</td>
                    <td>@(barbero.Activo ? "Activo" : "Inactivo")</td>
                    <td><a href="/admin/barberos/editar/@barbero.Id">Editar</a></td>
                </tr>
            }
        </tbody>
    </table>
}
