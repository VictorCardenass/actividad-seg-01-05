@model List<Servicio>
@{
    ViewData["Titulo"] = "Servicios";
}

<h1>Servicios</h1>

@if (Model.Count == 0)
{
    <partial name="_AvisoVacio" model='"Por ahora no hay servicios disponibles."' />
}
else
{
    <ul>
        @foreach (var servicio in Model)
        {
            <li>@servicio.Nombre - $@servicio.Precio - @servicio.Duracion min</li>
        }
    </ul>
}
